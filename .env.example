# GitHub (manager-only: PR creation and issue dispatch; not forwarded to worker/reviewer sandboxes)
GITHUB_TOKEN=

# Webhook listener (required only for GitHub issue automation)
# Enable this only when you have configured a signed GitHub Actions webhook.
HOCA_WEBHOOK_ENABLED=false
HOCA_WEBHOOK_SECRET=
HOCA_WEBHOOK_URL=
HOCA_WORKSPACE_ROOT=~/code
# Fleet control root for project registry, task board, scheduler state, and
# fleet reports. Leave at the default unless you want to isolate control-plane
# state from your home directory.
HOCA_CONTROL_ROOT=~/.hoca/control
# Optional comma-separated owner/repo allowlist. Leave empty to allow any repo
# under HOCA_WORKSPACE_ROOT.
HOCA_ALLOWED_REPOS=
HOCA_MAX_WEBHOOK_BYTES=65536

# Telegram notifications (optional)
HOCA_NOTIFY_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Ollama compatibility aliases. HOCA never uses these as implicit
# fallbacks; configure the role model blocks below for every HOCA run.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Ollama aliases:
#   OLLAMA_HOST — falls back to OLLAMA_BASE_URL
#   OLLAMA_API_BASE — falls back to OLLAMA_BASE_URL
# Doctor uses this for the hardware recommendation only.
HOCA_RECOMMENDED_RAM_GB=48

# Role model configuration for manager/worker/reviewer phases. HOCA is model
# agnostic and fails closed when no role model is configured; it never chooses a
# built-in model for you. Put the exact model name, base URL, and API key that
# your chosen local runtime, gateway, or cloud provider expects.
#
# Fresh local setups should usually keep all three roles on one resident model
# so the runtime can avoid swapping between interleaved phases.
#
# Only the selected role model is forwarded to worker/reviewer execution as
# LLM_MODEL, LLM_BASE_URL, and LLM_API_KEY. Raw role model credentials stay in
# manager-side configuration and are stripped before phase execution.
#
# Local runtimes: use any OpenAI-compatible server by setting
# *_MODEL_BASE_URL. Examples include MLX, llama.cpp server, LM Studio, LocalAI,
# vLLM, and NVIDIA Spark-style local endpoints when they expose the OpenAI
# protocol. Ollama remains supported with ollama/... model names.
#
# Cloud or enterprise models (OpenAI, Anthropic, Gemini, DeepSeek, etc.): leave
# *_MODEL_BASE_URL empty. LiteLLM infers the provider endpoint from the model
# prefix (openai/, anthropic/, gemini/, deepseek/, etc.) and your *_MODEL_API_KEY.
# Set *_MODEL_BASE_URL only when your provider requires a custom endpoint — for
# example Azure OpenAI, a private gateway, or a vendor-specific base URL.
#
# Explicit multi-model opt-in — local OpenAI-compatible manager/reviewer,
# worker on a hosted provider (commented; copy to activate only when your
# machine or hosted providers can absorb the extra residency/swap cost):
# HOCA_MANAGER_MODEL_NAME=manager
# HOCA_MANAGER_MODEL_MODEL=mlx-community/Qwen3-14B-4bit
# HOCA_MANAGER_MODEL_BASE_URL=http://127.0.0.1:8080/v1
# HOCA_MANAGER_MODEL_API_KEY=local
#
# HOCA_WORKER_MODEL_NAME=worker
# HOCA_WORKER_MODEL_MODEL=deepseek/deepseek-chat
# HOCA_WORKER_MODEL_BASE_URL=
# HOCA_WORKER_MODEL_API_KEY=
#
# HOCA_REVIEWER_MODEL_NAME=reviewer
# HOCA_REVIEWER_MODEL_MODEL=openai/gpt-oss-20b
# HOCA_REVIEWER_MODEL_BASE_URL=http://127.0.0.1:8080/v1
# HOCA_REVIEWER_MODEL_API_KEY=local
HOCA_MANAGER_MODEL_NAME=manager
HOCA_MANAGER_MODEL_MODEL=mlx-community/Qwen3-14B-4bit
HOCA_MANAGER_MODEL_BASE_URL=http://127.0.0.1:8080/v1
HOCA_MANAGER_MODEL_API_KEY=local

HOCA_WORKER_MODEL_NAME=worker
HOCA_WORKER_MODEL_MODEL=mlx-community/Qwen3-14B-4bit
HOCA_WORKER_MODEL_BASE_URL=http://127.0.0.1:8080/v1
HOCA_WORKER_MODEL_API_KEY=local

HOCA_REVIEWER_MODEL_NAME=reviewer
HOCA_REVIEWER_MODEL_MODEL=mlx-community/Qwen3-14B-4bit
HOCA_REVIEWER_MODEL_BASE_URL=http://127.0.0.1:8080/v1
HOCA_REVIEWER_MODEL_API_KEY=local

# Local backend residency. Keep the selected model loaded across
# manager/worker/reviewer phases when your backend supports it, and run only
# the model(s) your RAM can hold alongside Docker/sandbox memory.
#
# Ollama example:
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_MAX_LOADED_MODELS=1
#
# MLX, llama.cpp, LM Studio, LocalAI, vLLM, and other OpenAI-compatible servers
# have backend-specific equivalents: keep the server process alive, disable idle
# unload where available, cap prompt/model cache size when needed, and avoid
# loading extra models unless your machine has headroom.

# Workflow mode. HOCA runs through Hermes role profiles and structured reports.
# Kanban is an advanced durable multi-agent mode and is not required for basic
# `hoca run`.
HOCA_USE_KANBAN=false
HOCA_MAX_TOTAL_ROUNDS=3

# Worker execution limits in seconds. v1.1 derives tighter per-run budgets from
# task risk and expected area count; explicit values here remain hard overrides.
HOCA_OPENHANDS_TIMEOUT=600
HOCA_OPENHANDS_STALL=300
# Derived-budget clamp bounds.
HOCA_BUDGET_MIN_TOTAL_ROUNDS=1
HOCA_BUDGET_MAX_TOTAL_ROUNDS=3
HOCA_BUDGET_MIN_OPENHANDS_TIMEOUT=240
HOCA_BUDGET_MAX_OPENHANDS_TIMEOUT=1200
HOCA_BUDGET_MIN_OPENHANDS_STALL=90
HOCA_BUDGET_MAX_OPENHANDS_STALL=600
HOCA_BUDGET_MIN_HERMES_TIMEOUT=600
HOCA_BUDGET_MAX_HERMES_TIMEOUT=2400

# Docker sandbox (recommended default: keep true for autonomous worker/reviewer runs)
# When true, OpenHands runs inside one HOCA-controlled container with bun/node/pnpm
# pre-installed. The container is isolated from the host filesystem (only the
# project worktree is mounted). Network egress is offline by default; opt into
# HOCA_NETWORK_MODE=package-install for dependency downloads when needed.
# Set to false only for explicit host-local execution (higher risk; see README).
HOCA_USE_SANDBOX=true
# When true, HOCA creates a disposable Git worktree for each run so the
# worker/reviewer operate on a copy rather than the user's active checkout.
# The worktree lives at .hoca-runtime/worktrees/<run_id>/ and is removed on
# cleanup. This avoids contaminating the active checkout with agent changes.
HOCA_USE_WORKTREE_SANDBOX=true
# Worker/reviewer execution mode. v1.1 fast defaults use direct OpenHands
# prompts while preserving task specs, monitor policy, tests, review, safe
# staging, and PR gates. Switch back to hermes if you want profile mediation.
HOCA_WORKER_MODE=direct
# HOCA_WORKER_MODE=hermes
HOCA_REVIEWER_MODE=direct
# HOCA_REVIEWER_MODE=hermes
# Worker engine. openhands keeps the Docker sandbox path by default.
# claude-code and codex use host-native one-shot CLI adapters; enable only after
# reading docs/security-model.md.
HOCA_WORKER_ENGINE=openhands
# HOCA_WORKER_ENGINE=claude-code
# HOCA_WORKER_ENGINE=codex
# Start best-effort reviewer warm-up during tests. Advisory only; failures are
# recorded in reviewer-warmup.json and do not fail the run.
HOCA_REVIEW_WARMUP=true
# Dependency install cache. Keep enabled; set HOCA_FORCE_INSTALL=true when
# validating dependency setup itself.
HOCA_FORCE_INSTALL=false
# HOCA removes target-repo .hoca-runtime on run exit and archives each run
# outside the target checkout for later inspection.
# Default archive root: ~/.hoca/runtime-archives/<repo-name>/<run-id>/
# Set HOCA_KEEP_RUNTIME=true only for immediate local debugging.
# HOCA_RUNTIME_ARCHIVE_ROOT=~/.hoca/runtime-archives
# HOCA_KEEP_RUNTIME=false
# Sandbox outbound network for worker/reviewer containers.
# offline: no external egress (--network none); safest after dependencies exist.
# package-install: Docker bridge; allows registry fetches but is not allowlisted.
# github-only: Docker bridge; GitHub-only egress is not enforced by Docker alone.
# full: unrestricted bridge egress; explicit opt-in only (set this var or task spec).
HOCA_NETWORK_MODE=offline
# HOCA_NETWORK_MODE=package-install
# HOCA_NETWORK_MODE=full
# Optional role-scoped overrides. Keep reviewer offline by default; set reviewer
# bridge mode only when it must reach a host-local or remote model endpoint.
# HOCA_WORKER_NETWORK_MODE=package-install
# HOCA_REVIEWER_NETWORK_MODE=package-install
# Sandbox resource limits
HOCA_SANDBOX_MEMORY=8g
HOCA_SANDBOX_PIDS=512
# Custom sandbox image (default: hoca-sandbox:latest, built from docker/Dockerfile.sandbox)
# HOCA_SANDBOX_IMAGE=hoca-sandbox:latest

# HOCA defaults (safe values — change only if you understand the implications)
# Development branches are target-repo owned. Set dev_branch in the target
# repository's .hoca/config.toml, or pass --dev-branch from the manager.
# When true and an origin remote exists, HOCA fetches the resolved development
# branch and creates task branches from that latest remote ref.
HOCA_SYNC_DEV_BRANCH=true
# When true, after a successful PR HOCA checks out the resolved dev branch so
# the local repo returns to normal work. Skipped when uncommitted non-runtime
# changes would be lost.
HOCA_RESTORE_DEV_BRANCH=true
# When true, HOCA stages the reviewed changed-file set after LGTM and then
# continues to commit, push, PR creation, and runtime cleanup.
HOCA_AUTO_STAGE_REVIEWED_CHANGES=true
HOCA_AUTO_MERGE=false
HOCA_REQUIRE_TESTS=true
HOCA_REQUIRE_REVIEW=true
HOCA_STOP_ON_DIRTY_TREE=true
# Total worker/review/repair rounds (default: 3). Round 1 is the initial
# implementation + review; rounds 2-3 are repair + review cycles.
# When true, hoca run calls init-project before starting a task.
HOCA_RUN_INIT_PROJECT=false
